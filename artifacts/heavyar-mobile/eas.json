{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HEAVYAR_QA_PERFORMANCE": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HEAVYAR_QA_PERFORMANCE": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_HEAVYAR_QA_PERFORMANCE": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
