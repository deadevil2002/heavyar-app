{
  "name": "@workspace/heavyar-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=20.19.4 <25"
  },
  "scripts": {
    "dev": "NODE_PATH=./node_modules EXPO_PACKAGER_PROXY_URL=https://${REPLIT_EXPO_DEV_DOMAIN:?Missing Replit Expo preview domain} expo start --lan --port $PORT",
    "start": "NODE_PATH=./node_modules expo start --tunnel",
    "start-web": "NODE_PATH=./node_modules expo start --web --tunnel",
    "start-web-dev": "NODE_PATH=./node_modules DEBUG=expo* expo start --web --tunnel",
    "lint": "expo lint",
    "test:transitions": "vitest run tests/requestTransitions.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test": "bun run test:transitions && bun run test:rules"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
